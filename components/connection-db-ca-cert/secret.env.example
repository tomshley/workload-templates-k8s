# Pointer to the PEM file (same pattern as TOMSHLEY_CICD_MIRROR_SSH_KEY in .env)
# The deploy script reads this key as a file path and loads via --from-file=
db-ca-bundle.pem=.secure_files/PLACEHOLDER-db-ca-bundle.pem
